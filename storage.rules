rules_version = '2';

// Group images live at: groupImages/{groupId}/{ownerUid}/{fileName}
// where ownerUid is the group creator's uid (set by the app). This lets us
// enforce creator-only writes with a simple path comparison and avoids a
// cross-service Firestore lookup (firestore.get), which isn't reliably
// available on all projects.
//
//   - read:  any authenticated user. In practice only group members ever obtain
//            the download URL, since it's stored on the group document, which is
//            member-gated in firestore.rules.
//   - write: only the user whose uid is in the path (the creator), and only
//            PNG/JPG under 15 MB.
service firebase.storage {
  match /b/{bucket}/o {

    function isValidImage() {
      // On delete, request.resource is null — allow it through the size/type gate.
      return request.resource == null || (
        request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg)')
      );
    }

    match /groupImages/{groupId}/{ownerUid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && isValidImage();
    }

    // Everything else is closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
