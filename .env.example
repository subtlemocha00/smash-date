# Smash Date — environment variables
#
# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase console → Project settings → General → "Your apps" → SDK setup and configuration.
#
# All variables are required. The `VITE_` prefix is mandatory — Vite only exposes
# prefixed variables to the client bundle. These are Firebase *client* config
# values (safe to ship in the frontend); access is enforced by Firestore rules,
# not by hiding these keys. Do not put server secrets or service-account keys here.
#
# `.env` is gitignored; this `.env.example` is committed as a template.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
