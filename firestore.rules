rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isAuth() &&
        request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupCreator(groupId) {
      let g = get(/databases/$(database)/documents/groups/$(groupId)).data;
      // Legacy groups predate createdBy; any member may manage them.
      return isAuth() && (
        (('createdBy' in g) && g.createdBy == request.auth.uid) ||
        (!('createdBy' in g) && request.auth.uid in g.memberIds)
      );
    }

    // True when the current user authored the referenced proposal. Used by the
    // cascade delete of a proposal's child docs (comments/responsibilities/
    // activity), which the proposal's creator may trigger.
    function isProposalCreatorById(proposalId) {
      let p = get(/databases/$(database)/documents/proposals/$(proposalId)).data;
      return isAuth() && ('createdBy' in p) && p.createdBy == request.auth.uid;
    }

    // A non-member joining via invite may only add themselves to memberIds,
    // leaving every other field untouched.
    function isSelfJoin(groupId) {
      let before = resource.data;
      let after = request.resource.data;
      return isAuth() &&
        !(request.auth.uid in before.memberIds) &&
        request.auth.uid in after.memberIds &&
        after.memberIds.removeAll(before.memberIds) == [request.auth.uid] &&
        after.name == before.name &&
        after.inviteCode == before.inviteCode &&
        // The joiner must not introduce or alter the creator field.
        (('createdBy' in before)
          ? (('createdBy' in after) && after.createdBy == before.createdBy)
          : !('createdBy' in after));
    }

    // Any member may set only their own entry in the memberNames map, and
    // nothing else on the group.
    function isOwnNameUpdate(groupId) {
      let before = resource.data;
      let after = request.resource.data;
      return isGroupMember(groupId) &&
        after.diff(before).affectedKeys().hasOnly(['memberNames']) &&
        (
          !('memberNames' in before) ||
          after.memberNames.diff(before.memberNames).affectedKeys()
            .hasOnly([request.auth.uid])
        );
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // Test the document directly (not via get()) so this is also valid for the
      // "memberIds array-contains uid" collection query the dashboard runs.
      allow read: if isAuth() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid;
      // Only the owner can rename or remove members; anyone holding a valid
      // invite may add themselves; any member may record their own name.
      allow update: if isGroupCreator(groupId)
        || isSelfJoin(groupId)
        || isOwnNameUpdate(groupId);
      // Only the owner can delete the entire group.
      allow delete: if isGroupCreator(groupId);
    }

    match /groupInvites/{code} {
      // Anyone authenticated can read an invite by its code (required to join).
      allow read: if isAuth();
      // Only the group creator may publish an invite for their group.
      // FIX (HIGH): was `if isAuth()` — allowed any user to create invites for groups they don't own.
      allow create: if isGroupCreator(request.resource.data.groupId);
      // Only the owner of the referenced group may remove its invite.
      allow delete: if isGroupCreator(resource.data.groupId);
    }

    match /proposals/{proposalId} {
      // The caller is the proposal's creator (legacy docs predate createdBy).
      function isProposalDocCreator() {
        return ('createdBy' in resource.data) && resource.data.createdBy == request.auth.uid;
      }

      // acceptedBy may only gain/lose the caller's own uid, or be fully reset to
      // [] (an edit/transition clearing all approvals — can't forge acceptance).
      function acceptedByChangeIsSelfOrReset() {
        let before = ('acceptedBy' in resource.data) ? resource.data.acceptedBy : [];
        let after = ('acceptedBy' in request.resource.data) ? request.resource.data.acceptedBy : [];
        return after == before
          || after.size() == 0
          || (after.removeAll(before).hasOnly([request.auth.uid])
              && before.removeAll(after).hasOnly([request.auth.uid]));
      }

      // dismissedByUserIds may only gain/lose the caller's own uid.
      function dismissedChangeIsSelf() {
        let before = ('dismissedByUserIds' in resource.data) ? resource.data.dismissedByUserIds : [];
        let after = ('dismissedByUserIds' in request.resource.data) ? request.resource.data.dismissedByUserIds : [];
        return after == before
          || (after.removeAll(before).hasOnly([request.auth.uid])
              && before.removeAll(after).hasOnly([request.auth.uid]));
      }

      allow read: if isGroupMember(resource.data.groupId);
      // Only group members may create proposals.
      allow create: if isAuth() && isGroupMember(request.resource.data.groupId);
      // Members may update proposal fields, but groupId is immutable after creation.
      // FIX (MEDIUM): was `allow read, update, delete` with no field constraints — groupId could be changed.
      //
      // Status flow guarantees (completion itself is derived from the date on the
      // client — there's no scheduler — so it isn't enforced here):
      //  * Confirming is creator-only, and a confirmed proposal is frozen to
      //    everyone but the creator (who can reopen it).
      //  * acceptedBy may only be changed for one's own uid (you can't accept on
      //    behalf of others); a full reset to [] is allowed (edits/transitions).
      //  * dismissedByUserIds may only be changed for one's own uid.
      //  * Per-user manual archive writes only archivedByUserIds, allowed here.
      allow update: if isGroupMember(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        // A confirmed proposal is locked to everyone but the creator.
        && (resource.data.status != 'confirmed' || isProposalDocCreator())
        // Confirming (→ confirmed) is creator-only.
        && (
          !(request.resource.data.status == 'confirmed' && resource.data.status != 'confirmed')
          || isProposalDocCreator()
        )
        && acceptedByChangeIsSelfOrReset()
        && dismissedChangeIsSelf();
      // Only the proposal's creator may delete it; the group owner may also
      // remove it (e.g. as part of deleting the whole group).
      allow delete: if isGroupMember(resource.data.groupId) && (
        (('createdBy' in resource.data) && resource.data.createdBy == request.auth.uid)
        || isGroupCreator(resource.data.groupId)
      );
    }

    match /comments/{commentId} {
      allow read: if isGroupMember(
        get(/databases/$(database)/documents/proposals/$(resource.data.proposalId)).data.groupId
      );
      allow create: if isAuth() && isGroupMember(
        get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.groupId
      );
      // Members may update comment content, but proposalId and userId are immutable.
      // FIX (MEDIUM): was merged with read/delete — no field constraints on update.
      allow update: if isGroupMember(
          get(/databases/$(database)/documents/proposals/$(resource.data.proposalId)).data.groupId
        )
        && request.resource.data.proposalId == resource.data.proposalId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isGroupMember(
        get(/databases/$(database)/documents/proposals/$(resource.data.proposalId)).data.groupId
      );
    }

    match /responsibilities/{responsibilityId} {
      allow read: if isGroupMember(
        get(/databases/$(database)/documents/proposals/$(resource.data.proposalId)).data.groupId
      );
      allow create: if isAuth() && isGroupMember(
        get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.groupId
      );
      // Members may update responsibility fields, but proposalId is immutable.
      // FIX (MEDIUM): was merged with read/delete — proposalId could be changed to move data between proposals.
      allow update: if isGroupMember(
          get(/databases/$(database)/documents/proposals/$(resource.data.proposalId)).data.groupId
        )
        && request.resource.data.proposalId == resource.data.proposalId;
      allow delete: if isGroupMember(
        get(/databases/$(database)/documents/proposals/$(resource.data.proposalId)).data.groupId
      );
    }

    match /activityEvents/{eventId} {
      // Activity events are append-only audit logs — no update rule.
      allow read: if isGroupMember(
        get(/databases/$(database)/documents/proposals/$(resource.data.proposalId)).data.groupId
      );
      allow create: if isAuth() && isGroupMember(
        get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.groupId
      );
      // Only the group creator may delete individual activity events; the
      // proposal's creator may also delete them as part of cascade-deleting
      // their proposal. Both deleteGroup() and deleteProposal() run in a batch,
      // so Firestore evaluates this against pre-commit state where the group and
      // proposal still exist.
      // FIX (MEDIUM): was `isGroupMember` — any member could delete audit log entries.
      allow delete: if isProposalCreatorById(resource.data.proposalId)
        || isGroupCreator(
          get(/databases/$(database)/documents/proposals/$(resource.data.proposalId)).data.groupId
        );
    }
  }
}
